    "test": "node tools/unit-test.js",
    "seed": "node tools/reseed.js",
    "sprites": "node tools/mirror-sprites.js --only-universe",
    "cn": "node tools/build-cn-data.js",
    "verify:cn": "node tools/verify-cn-data.js",
    "terms": "node tools/build-cn-terms.js",
    "verify:terms": "node tools/verify-cn-terms.js",
    "phrases": "node tools/build-cn-phrases.js",
    "audit:eggs": "node tools/audit-egg-groups.js",
    "audit:sources": "node tools/audit-cn-sources.js",
