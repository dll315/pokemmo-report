# 复制成 .env 再填（.env 已在 .gitignore 里，不会被提交）

# 管理台登录账号与密码。留空 ADMIN_PASSWORD = 禁止登录管理台（管理接口全部 401）。
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# 企业微信机器人：建议留空，起站后在管理台「推送设置」里填（写进 data/config.json，重建容器不丢）。
# 这里一旦填了就以它为准，网页里改不会生效 —— 所以默认不填。
WECOM_WEBHOOK=

# 前面挂了 Nginx 反代时设 1，上报限频才按真实访客 IP 算；直连保持 0
TRUST_PROXY=0
